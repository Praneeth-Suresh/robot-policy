{
  "$id": "run_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "type": "object"
    },
    "episodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string"
          },
          "episode_id": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          }
        },
        "required": [
          "episode_id",
          "condition",
          "seed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "type": "string"
        },
        "checkpoint_sha256": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "checkpoint_id",
        "checkpoint_sha256"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "git_commit": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "git_commit",
        "command",
        "created_at"
      ],
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "0.1"
    },
    "simulator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "synthetic": {
      "default": false,
      "type": "boolean"
    },
    "task": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task",
    "policy",
    "simulator",
    "provenance",
    "episodes"
  ],
  "type": "object"
}
